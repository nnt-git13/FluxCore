root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python
[*.py]
indent_style = space
indent_size = 4

# SystemVerilog and Verilog
[*.{sv,v,vh,svh}]
indent_style = space
indent_size = 4

# C and C++ (bare-metal software)
[*.{c,h,cpp,hpp}]
indent_style = space
indent_size = 4

# Tcl (Vivado scripts)
[*.tcl]
indent_style = space
indent_size = 4

# Makefiles require tabs
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# TOML configuration
[*.toml]
indent_style = space
indent_size = 4

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 4

# Linker scripts and assembly
[*.{ld,S,s}]
indent_style = space
indent_size = 4

# Questa do scripts
[*.do]
indent_style = space
indent_size = 4

# File lists
[*.f]
indent_style = space
indent_size = 4
